                  "pm.test(\"Monitor normalizado con materia_nombre\", () => pm.expect(m).to.eql({ codigo: \"DEV-001\", nombre: \"José Ñúñez Peña\", correo: \"jose.nunez@ucaldas.edu.co\", materia_id: 1, materia_nombre: \"Ingeniería de Software III\" }));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
