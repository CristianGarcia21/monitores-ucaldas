          "name": "Limpieza previa: DELETE /monitores/{{codigo}}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204 o 404\", () => pm.expect(pm.response.code).to.be.oneOf([204, 404]));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitores/{{codigo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "monitores",
                "{{codigo}}"
              ]
            },
            "description": "Borra DEV-001 si quedó de una ejecución anterior. Acepta 204 o 404."
          }
        },
        {
          "name": "GET /monitores (RF2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type JSON UTF-8\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/application\\/json;\\s*charset=utf-8/i));",
                  "const lista = pm.response.json();",
                  "pm.test(\"Arreglo plano (J3)\", () => pm.expect(lista).to.be.an(\"array\"));",
                  "pm.test(\"Ordenada por código\", () => { const c = lista.map(m => m.codigo); pm.expect(c).to.eql([...c].sort()); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "monitores"
              ]
            },
            "description": "Lista de monitores ordenada por código (J7). Sin monitores responde [] (J4)."
          }
        },
        {
          "name": "POST /monitores (RF1) → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", () => pm.response.to.have.status(201));",
