            "description": "Crea un monitor. El cuerpo trae espacios, minúsculas y mayúsculas a propósito: se guarda normalizado (§6.1).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \" dev-001 \",\n  \"nombre\": \"José  Ñúñez Peña\",\n  \"correo\": \"Jose.Nunez@UCaldas.edu.co\",\n  \"materia_id\": 1\n}",
              "options": {
