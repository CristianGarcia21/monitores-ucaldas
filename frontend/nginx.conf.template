# Plantilla de nginx: al arrancar, la imagen oficial reemplaza ${JAVA_SERVICE_URL} por el valor de esa
# variable de entorno y genera /etc/nginx/conf.d/default.conf. Las variables propias de nginx ($host,
# $uri) no se tocan porque no son variables de entorno.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # El navegador solo habla con nginx; /api/* se reenvía al controlador Java quitando /api.
    # Así la interfaz nunca toca la base de datos ni necesita CORS.
    # JAVA_SERVICE_URL no termina en "/" (contrato §2); por defecto http://java-controller:8081.
    location /api/ {
        proxy_pass ${JAVA_SERVICE_URL}/;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
