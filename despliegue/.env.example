# Copiar como despliegue/.env en CADA equipo y poner las IP reales de la red.
# Docker Compose lo lee solo, porque está en la misma carpeta que los archivos pcN-*.yml.
# Las URL no terminan en "/" (contrato §2).

# PC1 (presentación) necesita la IP del PC2, donde corre PHP
PHP_SERVICE_URL=http://192.168.1.20:8082

# PC2 (intermediario) necesita la IP del PC3, donde corre Python
PYTHON_SERVICE_URL=http://192.168.1.30:8083

# Opcional: cambiar el puerto publicado si está ocupado en ese equipo (ver despliegue/README.md)
# FRONTEND_PORT=8080
# JAVA_PORT=8081
# PHP_PORT=8082
# PYTHON_PORT=8083
# DB_PORT=5432
